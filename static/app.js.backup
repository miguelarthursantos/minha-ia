/* =========================================================
   LOGIN / APP
   ========================================================= */

function mostrarLogin() {

    if (loginTela) {
        loginTela.style.display = "flex";
    }

    if (appTela) {
        appTela.style.display = "none";
    }
}


function mostrarApp() {

    if (loginTela) {
        loginTela.style.display = "none";
    }

    if (appTela) {
        appTela.style.display = "flex";
    }

    setTimeout(() => {

        if (perguntaInput) {
            perguntaInput.focus();
        }

    }, 100);
}


/* =========================================================
   LOGIN
   ========================================================= */

async function fazerLogin(event) {

    event.preventDefault();

    const usuario =
        document
            .getElementById("loginUsuario")
            .value
            .trim();

    const senha =
        document
            document
            .getElementById("loginSenha")
            .value;

    if (!usuario || !senha) {

        mostrarAviso(
            "Preencha usuÃ¡rio e senha."
        );

        return;
    }

    try {

        const resposta =
            await fetch(
                "/login",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            usuario:
                                usuario,

                            senha:
                                senha
                        })
                }
            );

        const dados =
            await resposta.json();

        if (dados.sucesso) {

            if (loginForm) {
                loginForm.reset();
            }

            mostrarApp();

            await carregarUsuario();

            await carregarProjetos();

            await carregarConversas();

        } else {

            mostrarAviso(
                dados.erro ||
                "UsuÃ¡rio ou senha incorretos."
            );
        }

    } catch (erro) {

        console.error(
            "Erro no login:",
            erro
        );

        mostrarAviso(
            "NÃ£o foi possÃ­vel conectar ao servidor."
        );
    }
}

