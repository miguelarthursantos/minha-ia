/* =========================================================
   CADASTRO
   ========================================================= */

async function fazerCadastro(event) {

    event.preventDefault();

    const usuario =
        document
            .getElementById("cadastroUsuario")
            .value
            .trim();

    const senha =
        document
            .getElementById("cadastroSenha")
            .value;

    if (!usuario || !senha) {

        mostrarAviso(
            "Preencha todos os campos."
        );

        return;
    }

    try {

        const resposta =
            await fetch(
                "/cadastro",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        usuario: usuario,
                        senha: senha
                    })
                }
            );

        const dados =
            await resposta.json();

        if (dados.sucesso) {

            mostrarAviso(
                "Conta criada com sucesso! Agora faÃ§a login. âœ…"
            );

            cadastroForm.reset();

        } else {

            mostrarAviso(
                dados.erro ||
                "Erro ao criar conta."
            );
        }

    } catch (erro) {

        console.error(
            "Erro no cadastro:",
            erro
        );

        mostrarAviso(
            "NÃ£o foi possÃ­vel conectar ao servidor."
        );
    }
}


if (cadastroForm) {

    cadastroForm.addEventListener(
        "submit",
        fazerCadastro
    );
}


/* =========================================================
   USUÃRIO
   ========================================================= */

async function carregarUsuario() {

    try {

        const resposta =
            await fetch(
                "/usuario"
            );

        if (!resposta.ok) {
            return;
        }

        const dados =
            await resposta.json();

        if (!dados.logado) {
            return;
        }

        const usuario =
            dados.usuario ||
            dados.nome ||
            dados.username ||
            "UsuÃ¡rio";

        if (nomeUsuario) {
            nomeUsuario.textContent =
                usuario;
        }

        if (usuarioConfiguracoes) {
            usuarioConfiguracoes.textContent =
                usuario;
        }

    } catch (erro) {

        console.error(
            "Erro ao carregar usuÃ¡rio:",
            erro
        );
    }
}


/* =========================================================
   PROJETOS
   ========================================================= */

async function carregarProjetos() {

    if (!listaProjetos) {
        return;
    }

    try {

        const resposta =
            await fetch(
                "/projetos"
            );

        const dados =
            await resposta.json();

        listaProjetos.innerHTML = "";

        if (
            !dados ||
            !Array.isArray(dados)
        ) {
            return;
        }

        dados.forEach(
            function(projeto) {

                const item =
                    document.createElement(
                        "div"
                    );

                item.className =
                    "projeto-item";

                item.dataset.id =
                    projeto.id;

                const icone =
                    projeto.icone ||
                    "ðŸ“";

                const nome =
                    projeto.nome ||
                    "Projeto";

                const descricao =
                    projeto.descricao ||
                    "";

                item.innerHTML = `
                    <div class="projeto-icone">
                        ${icone}
                    </div>

                    <div class="projeto-info">
                        <div class="projeto-nome">
                            ${nome}
                        </div>

                        <div class="projeto-descricao">
                            ${descricao}
                        </div>
                    </div>
                `;

                item.addEventListener(
                    "click",
                    function() {
                        abrirProjeto(
                            projeto.id
                        );
                    }
                );

                listaProjetos.appendChild(
                    item
                );
            }
        );

    } catch (erro) {

        console.error(
            "Erro ao carregar projetos:",
            erro
        );
    }
}


/* =========================================================
   ABRIR PROJETO
   ========================================================= */

async function abrirProjeto(id) {

    if (!id) {
        return;
    }

    projetoAtualId =
        Number(id);

    try {

        const resposta =
            await fetch(
                `/projeto/${id}`
            );

        const dados =
            await resposta.json();

        if (!resposta.ok) {

            mostrarAviso(
                dados.erro ||
                "NÃ£o foi possÃ­vel abrir o projeto."
            );

            return;
        }

        projetoAtual =
            dados.projeto ||
            null;

        if (tituloProjetoAtual) {

            tituloProjetoAtual.textContent =
                projetoAtual &&
                projetoAtual.nome
                    ? projetoAtual.nome
                    : "Projeto";
        }

        if (subtituloProjetoAtual) {

            subtituloProjetoAtual.textContent =
                projetoAtual &&
                projetoAtual.descricao
                    ? projetoAtual.descricao
                    : "";
        }

        if (
            dados.conversas &&
            Array.isArray(
                dados.conversas
            )
        ) {

            renderizarConversas(
                dados.conversas
            );

        } else {

            await carregarConversas();
        }

    } catch (erro) {

        console.error(
            "Erro ao abrir projeto:",
            erro
        );

        mostrarAviso(
            "NÃ£o foi possÃ­vel abrir o projeto."
        );
    }
}

